# pb-dashboard — 슬랙·Gmail 실시간 발주 수집 환경변수
# 이 파일을 .env 로 복사해 값을 채우세요 (.env 는 git에 커밋하지 마세요).
#   cp .env.example .env
# 배포 환경(Render/Fly)에서는 이 파일 대신 플랫폼의 Secret/Environment 설정에
# 직접 입력합니다 — 절대 .env 자체를 커밋하거나 platform 설정 화면 밖으로
# 복사해 공유하지 마세요.

# ── 슬랙 발주 채널 (build/config.json 의 slack.channelId) ──────────────
# Bot User OAuth Token. https://api.slack.com/apps → 대상 앱 → OAuth & Permissions
# 필요 스코프: channels:history (비공개 채널이면 groups:history) · channels:read · users:read
# 발급 후 반드시 해당 채널에 이 봇을 초대해야 메시지를 읽을 수 있습니다 (/invite @봇이름)
SLACK_BOT_TOKEN=xoxb-...

# ── 해외 발주 메일함 (build/config.json 의 gmail.senders) — IMAP 방식 ──
# 1) 해당 구글 계정에서 2단계 인증을 켠다
# 2) https://myaccount.google.com/apppasswords 에서 앱 비밀번호를 발급한다
# 3) 아래에 계정과 앱 비밀번호(공백 제거)를 넣는다
GMAIL_USER=you@yourcompany.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# ── git commit/push 자동화 ──────────────────────────────────────────
# 배포 환경(Render/Fly)의 체크아웃에는 기본적으로 push 권한이 없습니다.
# GitHub → Settings → Developer settings → Fine-grained personal access token
# 생성 시 이 저장소만 선택하고 권한은 Contents: Read and write 만 부여하세요.
GITHUB_PUSH_TOKEN=github_pat_...

# ── 실시간 수집 스레드 (dashboard.py 안에서 함께 실행) ──────────────────
REALTIME_SYNC=1
REALTIME_SYNC_INTERVAL_MIN=2
REALTIME_SYNC_LOOKBACK_MIN=180
